{
  "app": {
    "title": "多協定PLC HMI",
    "window_width": 1280,
    "window_height": 800,
    "refresh_interval_ms": 500
  },
  "modbus_rtu": {
    "enable": false,
    "connection_id": "conn-modbus-rtu-example",
    "port": "COM3",
    "baudrate": 9600,
    "bytesize": 8,
    "parity": "N",
    "stopbits": 1,
    "timeout": 1.0,
    "poll_interval": 1.0,
    "devices": [
      {
        "enable": true,
        "name": "範例Modbus_RTU_PLC",
        "device_id": "device-modbus-rtu-example",
        "station_id": 1,
        "points": [
          {
            "enable": true,
            "name": "範例保持暫存器",
            "tag_id": "tag-rtu-holding-register",
            "type": "holding_register",
            "address": 0,
            "address_base": 0,
            "count": 1,
            "data_type": "UInt16",
            "byte_order": "big",
            "word_order": "big",
            "writable": false,
            "db_enable": true
          },
          {
            "enable": true,
            "name": "範例輸入暫存器",
            "tag_id": "tag-rtu-input-register",
            "type": "input_register",
            "address": 10,
            "address_base": 0,
            "count": 2,
            "data_type": "Float32_ABCD",
            "byte_order": "big",
            "word_order": "big",
            "writable": false,
            "db_enable": true
          },
          {
            "enable": true,
            "name": "範例線圈",
            "tag_id": "tag-rtu-coil",
            "type": "coil",
            "address": 0,
            "address_base": 0,
            "count": 1,
            "data_type": "Bool",
            "writable": false,
            "db_enable": true
          },
          {
            "enable": true,
            "name": "範例離散輸入",
            "tag_id": "tag-rtu-discrete-input",
            "type": "discrete_input",
            "address": 0,
            "address_base": 0,
            "count": 1,
            "data_type": "Bool",
            "writable": false,
            "db_enable": true
          }
        ]
      }
    ]
  },
  "modbus_tcp": {
    "enable": false,
    "timeout": 3.0,
    "poll_interval": 1.0,
    "devices": [
      {
        "enable": true,
        "name": "範例Modbus_TCP_PLC",
        "connection_id": "conn-modbus-tcp-example",
        "device_id": "device-modbus-tcp-example",
        "host": "192.0.2.10",
        "port": 502,
        "station_id": 1,
        "points": [
          {
            "enable": true,
            "name": "範例生產數量",
            "tag_id": "tag-production-count",
            "type": "holding_register",
            "address": 0,
            "address_base": 0,
            "count": 1,
            "data_type": "UInt16",
            "byte_order": "big",
            "word_order": "big",
            "writable": false,
            "db_enable": true
          },
          {
            "enable": true,
            "name": "範例運轉狀態",
            "tag_id": "tag-running",
            "type": "coil",
            "address": 0,
            "address_base": 0,
            "count": 1,
            "data_type": "Bool",
            "writable": false,
            "db_enable": true
          }
        ]
      }
    ]
  },
  "opcua": {
    "enable": false,
    "servers": [
      {
        "enable": true,
        "name": "範例OPC_UA_Server",
        "endpoint_url": "opc.tcp://127.0.0.1:4840",
        "use_username": false,
        "username": "",
        "password": "",
        "timeout": 5.0,
        "subscription_interval_ms": 1000,
        "nodes": [
          {
            "enable": true,
            "name": "範例運轉狀態",
            "node_id": "ns=2;s=Machine.Running",
            "subscribe": true,
            "writable": false,
            "data_type": "Boolean",
            "db_enable": true
          },
          {
            "enable": true,
            "name": "範例速度",
            "node_id": "ns=2;s=Machine.Speed",
            "subscribe": true,
            "writable": false,
            "data_type": "Float",
            "db_enable": true
          }
        ]
      }
    ]
  },
  "gateway_outputs": {
    "modbus_tcp_server": {
      "enable": false,
      "host": "127.0.0.1",
      "port": 1502,
      "coil_start": 0,
      "coil_end": 65535,
      "register_start": 0,
      "register_end": 65535
    },
    "opcua_server": {
      "enable": false,
      "endpoint": "opc.tcp://127.0.0.1:4841"
    }
  },
  "gateway_model": {
    "connections": [],
    "devices": [],
    "tags": []
  },
  "database": {
    "enable": false,
    "host": "127.0.0.1",
    "port": 3306,
    "user": "",
    "password": "",
    "database": "plc_hmi",
    "charset": "utf8mb4",
    "connect_timeout": 5,
    "write_history": true,
    "write_latest": true,
    "write_only_on_change": true
  }
}
